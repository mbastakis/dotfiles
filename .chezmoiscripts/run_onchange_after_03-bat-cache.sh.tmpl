#!/bin/bash
# Rebuild bat's cache when the managed theme changes.
# theme-hash: {{ include "private_dot_config/bat/themes/Catppuccin Mocha.tmTheme" | sha256sum }}

{{- if ne .chezmoi.os "darwin" }}
exit 0
{{- end }}

set -euo pipefail

if ! command -v bat &>/dev/null; then
    echo "Warning: bat is not installed; run 'chezmoi apply' after installing packages." >&2
    exit 0
fi

bat cache --build
