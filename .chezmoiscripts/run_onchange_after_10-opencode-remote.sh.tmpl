#!/bin/bash
# Reconcile the OpenCode v2 remote-access stack on the designated Mac.
#
# Atlas owns browser authentication. This script pushes provider credentials to
# the service, reloads the service and credential-bridge LaunchAgents, removes
# retired oauth2-proxy artifacts, and converges Tailscale Serve to the bridge.
{{- if ne .chezmoi.hostname .opencode.remote.host }}
exit 0
{{- else }}
# hash-launch-agents: {{ includeTemplate "private_Library/LaunchAgents/com.mbastakis.opencode-service-ensure.plist.tmpl" . | sha256sum }} {{ includeTemplate "private_Library/LaunchAgents/com.mbastakis.opencode-auth-bridge.plist.tmpl" . | sha256sum }}
# hash-controller: {{ includeTemplate "literal_bin/executable_opencode-server.tmpl" . | sha256sum }}
# hash-bridge-runtime: {{ include "private_dot_local/private_libexec/opencode-server/executable_auth-bridge" | sha256sum }}
# hash-provider-environment: {{ includeTemplate "private_dot_config/zsh/exports.zsh.tmpl" . | sha256sum }}

set -euo pipefail
export PATH="$HOME/.opencode/bin:$HOME/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

domain="gui/$(id -u)"

# Provider credentials for the background service (it has no zsh environment).
if [[ -f "$HOME/.config/zsh/exports.zsh" ]]; then
    /bin/zsh -c '
        source "$HOME/.config/zsh/exports.zsh"
        for var in WCS_API_KEY WCS_DEV_API_KEY SELFHOSTED_LLM_API_KEY OPENCODE_API_KEY; do
            [[ -n "${(P)var:-}" ]] && opencode2 service set env "$var" "${(P)var}" >/dev/null
        done
        exit 0
    '
fi

# Remove the retired Mac-local OIDC layer before starting the bridge.
launchctl bootout "$domain/com.mbastakis.opencode-oauth2-proxy" 2>/dev/null || true
rm -f \
    "$HOME/Library/LaunchAgents/com.mbastakis.opencode-oauth2-proxy.plist" \
    "$HOME/.local/libexec/opencode-server/oauth2-proxy"
rm -rf "$HOME/.config/oauth2-proxy" "$HOME/.local/state/opencode-remote"

# Migrate the old misleading ensure-job name, then load the focused replacement.
launchctl bootout "$domain/com.mbastakis.opencode-server" 2>/dev/null || true
rm -f "$HOME/Library/LaunchAgents/com.mbastakis.opencode-server.plist"
launchctl bootout "$domain/com.mbastakis.opencode-service-ensure" 2>/dev/null || true
launchctl bootstrap "$domain" "$HOME/Library/LaunchAgents/com.mbastakis.opencode-service-ensure.plist"

exec "$HOME/bin/opencode-server" restart bridge
{{- end }}
