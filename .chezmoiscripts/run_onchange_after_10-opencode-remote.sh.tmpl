#!/bin/bash
# Reconcile the OpenCode v2 remote-access stack on the designated Mac.
#
# The opencode2 background service hot-reloads config, agents, commands, and
# skills on its own; this script only handles what lives outside the service:
# provider credentials in the service environment, the two LaunchAgents, and
# stack convergence via opencode-server.
{{- if ne .chezmoi.hostname .opencode.remote.host }}
exit 0
{{- else }}
# hash-launch-agents: {{ includeTemplate "private_Library/LaunchAgents/com.mbastakis.opencode-server.plist.tmpl" . | sha256sum }} {{ includeTemplate "private_Library/LaunchAgents/com.mbastakis.opencode-oauth2-proxy.plist.tmpl" . | sha256sum }}
# hash-controller: {{ includeTemplate "literal_bin/executable_opencode-server.tmpl" . | sha256sum }}
# hash-proxy-config: {{ includeTemplate "private_dot_config/oauth2-proxy/private_oauth2-proxy.cfg.tmpl" . | sha256sum }}
# hash-provider-environment: {{ includeTemplate "private_dot_config/zsh/exports.zsh.tmpl" . | sha256sum }}

set -euo pipefail
export PATH="$HOME/.opencode/bin:$HOME/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

domain="gui/$(id -u)"

# Provider credentials for the background service (it has no zsh environment).
if [[ -f "$HOME/.config/zsh/exports.zsh" ]]; then
    /bin/zsh -c '
        source "$HOME/.config/zsh/exports.zsh"
        for var in WCS_API_KEY WCS_DEV_API_KEY SELFHOSTED_LLM_API_KEY OPENCODE_API_KEY; do
            [[ -n "${(P)var:-}" ]] && opencode2 service set env "$var" "${(P)var}" >/dev/null
        done
        exit 0
    '
fi

# Reload the ensure-service LaunchAgent; the proxy is reloaded by
# opencode-server start only when it is unhealthy, and restarted explicitly
# when its config changed (this script re-ran, so replace it).
launchctl bootout "$domain/com.mbastakis.opencode-server" 2>/dev/null || true
launchctl bootstrap "$domain" "$HOME/Library/LaunchAgents/com.mbastakis.opencode-server.plist"
launchctl bootout "$domain/com.mbastakis.opencode-oauth2-proxy" 2>/dev/null || true

exec "$HOME/bin/opencode-server" start
{{- end }}
