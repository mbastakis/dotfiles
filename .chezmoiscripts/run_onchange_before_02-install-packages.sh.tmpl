#!/bin/bash
# Install packages from Brewfile
# Runs when Brewfile content changes
# Brewfile hash: {{ include "private_dot_config/brew/Brewfile" | sha256sum }}

set -euo pipefail

BREWFILE_PATH="{{ .chezmoi.sourceDir }}/private_dot_config/brew/Brewfile"

# Package updates are explicit through the brew_update shell function.
export HOMEBREW_NO_AUTO_UPDATE=1

echo "Installing packages from Brewfile..."

if ! command -v brew &>/dev/null; then
    case "$(uname -m)" in
        arm64) brew_bin="/opt/homebrew/bin/brew" ;;
        x86_64) brew_bin="/usr/local/bin/brew" ;;
        *)
            echo "Error: unsupported macOS architecture: $(uname -m)" >&2
            exit 1
            ;;
    esac

    echo "Installing Homebrew..."
    if [[ ! -t 0 ]]; then
        echo "Warning: Homebrew is missing and its installer may require interactive sudo access." >&2
        echo "Install Homebrew from https://brew.sh in an interactive terminal, then retry chezmoi." >&2
        exit 1
    fi
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

    if [[ ! -x "$brew_bin" ]]; then
        echo "Error: Homebrew installer completed but brew was not found at ${brew_bin}." >&2
        exit 1
    fi
    eval "$("$brew_bin" shellenv)"
fi

if [[ -t 0 && -t 1 ]]; then
    brew bundle --file="$BREWFILE_PATH" --no-upgrade
else
    echo "Non-interactive shell detected. Skipping Mac App Store installs during chezmoi apply."
    # shellcheck disable=SC2016 # $1 belongs to the single-quoted Ruby program.
    mas_ids="$(ruby -ne 'puts $1 if /^\s*mas\s+.*\bid:\s*(\d+)/' "$BREWFILE_PATH")"
    if [[ -n "$mas_ids" ]]; then
        export HOMEBREW_BUNDLE_MAS_SKIP="${HOMEBREW_BUNDLE_MAS_SKIP:+${HOMEBREW_BUNDLE_MAS_SKIP} }${mas_ids//$'\n'/ }"
    fi
    brew bundle --file="$BREWFILE_PATH" --no-upgrade
    echo "To install Mac App Store apps later, run this in an interactive terminal:"
    echo "  HOMEBREW_NO_AUTO_UPDATE=1 brew bundle --file=\$HOME/.config/brew/Brewfile --no-upgrade"
fi

echo "Package installation complete!"
