#!/bin/bash
# Ensure shared and per-account mail runtime directories exist.

{{- if ne .chezmoi.os "darwin" }}
exit 0
{{- end }}

set -euo pipefail

{{- $mailRoot := replace "~" .chezmoi.homeDir .mail.defaults.mail_root }}
{{- $notmuchDatabase := replace "~" .chezmoi.homeDir .mail.defaults.notmuch_database }}
{{- $isyncStateRoot := replace "~" .chezmoi.homeDir .mail.defaults.isync_state_root }}
{{- $logRoot := replace "~" .chezmoi.homeDir .mail.defaults.log_root }}
{{- $automationHookRoot := replace "~" .chezmoi.homeDir .mail.defaults.automation_hook_root }}

mkdir -p \
    "{{ $mailRoot }}" \
    "{{ $notmuchDatabase }}" \
    "{{ $isyncStateRoot }}" \
    "{{ $logRoot }}" \
    "$HOME/.cache/neomutt" \
    "$HOME/.config/abook" \
    "$HOME/.local/share/abook" \
    "{{ $automationHookRoot }}"

{{- range .mail.accounts }}
{{- if .enabled }}
mkdir -p \
    "{{ printf "%s/%s" $mailRoot .id }}" \
    "{{ printf "%s/%s/%s/cur" $mailRoot .id .folders.inbox }}" \
    "{{ printf "%s/%s/%s/new" $mailRoot .id .folders.inbox }}" \
    "{{ printf "%s/%s/%s/tmp" $mailRoot .id .folders.inbox }}"

{{- end }}
{{- end }}
