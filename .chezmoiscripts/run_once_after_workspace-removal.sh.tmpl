#!/bin/bash
set -euo pipefail

{{- if ne .chezmoi.os "darwin" }}
exit 0
{{- end }}

launchctl bootout "gui/$(id -u)/com.mbastakis.workspace" >/dev/null 2>&1 || true
rm -rf \
    "$HOME/.local/state/workspace" \
    "${TMPDIR:-/tmp}/workspace-$(id -u)" \
    "$HOME/.cache/opencode/workspace-rows.json" \
    "$HOME/.local/state/opencode/tmux-panes"
rm -f \
    "$HOME/Library/Logs/workspace.log" \
    "$HOME/Library/Logs/workspace.error.log"
