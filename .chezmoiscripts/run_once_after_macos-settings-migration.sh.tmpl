#!/bin/bash
# Remove global shortcuts created by the retired Ghostty Cmd-H configuration.
{{- if ne .chezmoi.os "darwin" }}
exit 0
{{- end }}

set -euo pipefail

global_preferences="$HOME/Library/Preferences/.GlobalPreferences.plist"
if [[ -f "$global_preferences" ]]; then
    /usr/libexec/PlistBuddy -c "Delete :NSUserKeyEquivalents:'Hide Ghostty'" "$global_preferences" >/dev/null 2>&1 || true
    /usr/libexec/PlistBuddy -c "Delete :NSUserKeyEquivalents:'Hide Others'" "$global_preferences" >/dev/null 2>&1 || true
fi

killall cfprefsd >/dev/null 2>&1 || true
