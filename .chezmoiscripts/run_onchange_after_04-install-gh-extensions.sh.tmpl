#!/bin/bash
# Install the pinned gh-dash extension.
# gh-dash version: v4.25.2

{{- if ne .chezmoi.os "darwin" }}
exit 0
{{- end }}

set -euo pipefail

EXTENSION="dlvhdr/gh-dash"
VERSION="v4.25.2"

if ! command -v gh &>/dev/null; then
    echo "Warning: gh is not installed; rerun this script after installing packages." >&2
    exit 0
fi

installed_version="$(gh extension list 2>/dev/null | awk '$3 == "dlvhdr/gh-dash" { print $4; exit }')"
if [[ "$installed_version" == "$VERSION" ]]; then
    echo "gh-dash ${VERSION} is already installed."
    exit 0
fi

echo "Installing gh-dash ${VERSION}..."
if ! gh extension install "$EXTENSION" --pin "$VERSION" --force; then
    echo "Warning: failed to install ${EXTENSION}@${VERSION}; run 'gh extension install ${EXTENSION} --pin ${VERSION} --force' to diagnose." >&2
    exit 0
fi

installed_version="$(gh extension list 2>/dev/null | awk '$3 == "dlvhdr/gh-dash" { print $4; exit }')"
if [[ "$installed_version" != "$VERSION" ]]; then
    echo "Warning: expected gh-dash ${VERSION}, found '${installed_version:-missing}'." >&2
fi
