#!/bin/bash
# Ensure runtime directories configured by the shell environment exist.
# hash: runtime-dirs-v1

set -euo pipefail

xdg_config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
xdg_data_home="${XDG_DATA_HOME:-$HOME/.local/share}"
xdg_cache_home="${XDG_CACHE_HOME:-$HOME/.cache}"
xdg_state_home="${XDG_STATE_HOME:-$HOME/.local/state}"

gnupg_home="$xdg_data_home/gnupg"

mkdir -p \
    "$HOME/bin" \
    "$HOME/.local/bin" \
    "$xdg_config_home/kube" \
    "$xdg_data_home/colima" \
    "$xdg_data_home/go" \
    "$xdg_data_home/task" \
    "$xdg_cache_home/bun/install/cache" \
    "$xdg_cache_home/cdk" \
    "$xdg_cache_home/kube" \
    "$xdg_cache_home/terraform/plugins" \
    "$xdg_state_home/atuin/logs" \
    "$xdg_state_home/mcp-auth" \
    "$xdg_state_home/zsh" \
    "$gnupg_home"

chmod 700 "$gnupg_home"
