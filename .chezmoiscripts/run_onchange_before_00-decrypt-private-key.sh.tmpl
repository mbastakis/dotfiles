#!/bin/bash
# Decrypt age private key on first run (or when key.txt.age changes).
# This is the ONLY time the passphrase is needed.
# hash: {{ include "key.txt.age" | sha256sum }}

set -euo pipefail

key_dir="${HOME}/.config/chezmoi"
key_path="${key_dir}/key.txt"

mkdir -p "$key_dir"
temporary_key=$(mktemp "${key_dir}/.key.txt.XXXXXX")
trap 'rm -f "$temporary_key"' EXIT

chezmoi age decrypt --output "$temporary_key" --passphrase "{{ .chezmoi.sourceDir }}/key.txt.age"
chmod 600 "$temporary_key"
mv -f "$temporary_key" "$key_path"
trap - EXIT
