{{- $theme := index .theme.catalog .theme.active -}}
{{- $x := $theme.xterm256 -}}
# {{ $theme.display_name }} palette using catalog-owned xterm-256 indices.
# Use 256-color values by default so NeoMutt works reliably under `tmux-256color`.

set color_directcolor=no

color normal              {{ $x.text }} {{ $x.base }}
color error         bold  {{ $x.red }} {{ $x.base }}
color warning            {{ $x.yellow }} {{ $x.base }}
color message            {{ $x.green }} {{ $x.base }}
color prompt        bold  {{ $x.rose }} {{ $x.base }}
color options            {{ $x.blue }} {{ $x.base }}
color status             {{ $x.text }} {{ $x.overlay }}
color indicator    bold   {{ $x.base }} {{ $x.rose }}
color progress           {{ $x.base }} {{ $x.rose }}
color markers            {{ $x.disabled }}  {{ $x.base }}
color tree               {{ $x.disabled }}  {{ $x.base }}
color tilde              {{ $x.disabled }}  {{ $x.base }}
color search             {{ $x.base }} {{ $x.rose }}
color attachment         {{ $x.rose }} {{ $x.base }}
color signature          {{ $x.muted }} {{ $x.base }}
color compose_header bold {{ $x.blue }} {{ $x.base }}
color bold               {{ $x.rose }} {{ $x.base }}
color underline          {{ $x.blue }} {{ $x.base }}

color sidebar_background {{ $x.text }} {{ $x.mantle }}
color sidebar_divider    {{ $x.overlay_high }} {{ $x.mantle }}
color sidebar_ordinary   {{ $x.muted }} {{ $x.mantle }}
color sidebar_unread     {{ $x.blue }} {{ $x.mantle }}
color sidebar_new   bold {{ $x.green }} {{ $x.mantle }}
color sidebar_flagged    {{ $x.yellow }} {{ $x.mantle }}
color sidebar_spool_file {{ $x.rose }} {{ $x.mantle }}
color sidebar_highlight  {{ $x.base }} {{ $x.rose }}
color sidebar_indicator  {{ $x.base }} {{ $x.orchid }}

color index              {{ $x.text }} {{ $x.base }}
color index_number       {{ $x.disabled }}  {{ $x.base }}
color index_date         {{ $x.muted }} {{ $x.base }}
color index_author       {{ $x.orchid }} {{ $x.base }}
color index_flags        {{ $x.yellow }} {{ $x.base }}
color index_size         {{ $x.rose }} {{ $x.base }}
color index_subject      {{ $x.text }} {{ $x.base }}
color index_author  bold {{ $x.blue }} {{ $x.base }} ~N
color index_subject bold {{ $x.text }} {{ $x.base }} ~N
color index_date         {{ $x.rose }} {{ $x.base }} ~N
color index_flags   bold {{ $x.yellow }} {{ $x.base }} ~F
color index_subject      {{ $x.rose }} {{ $x.base }} ~F
color index              {{ $x.orchid }} {{ $x.base }} ~T
color index              {{ $x.red }} {{ $x.base }} ~D
color index_tags         {{ $x.green }} {{ $x.base }}
color index_tag          {{ $x.rose }} {{ $x.base }} "attachment"
color index_tag          {{ $x.green }} {{ $x.base }} "todo"
color index_tag          {{ $x.blue }} {{ $x.base }} "github"
color index_tag          {{ $x.aqua }} {{ $x.base }} "calendar"
color index_tag          {{ $x.yellow }} {{ $x.base }} "newsletter"

color hdrdefault         {{ $x.text }} {{ $x.base }}
color header             {{ $x.orchid }} {{ $x.base }} "^From: .*"
color header             {{ $x.blue }} {{ $x.base }} "^To: .*"
color header             {{ $x.green }} {{ $x.base }} "^Cc: .*"
color header             {{ $x.aqua }} {{ $x.base }} "^Reply-To: .*"
color header             {{ $x.text }} {{ $x.base }} "^Subject: .*"
color header             {{ $x.rose }} {{ $x.base }} "^Date: .*"
color header       bold  {{ $x.blue }} {{ $x.base }} "^From:"
color header       bold  {{ $x.aqua }} {{ $x.base }} "^To:"
color header       bold  {{ $x.green }} {{ $x.base }} "^Cc:"
color header       bold  {{ $x.aqua }} {{ $x.base }} "^Reply-To:"
color header       bold  {{ $x.rose }} {{ $x.base }} "^Subject:"
color header       bold  {{ $x.rose }} {{ $x.base }} "^Date:"

color quoted             {{ $x.muted }} {{ $x.base }}
color quoted1            {{ $x.blue }} {{ $x.base }}
color quoted2            {{ $x.aqua }} {{ $x.base }}
color quoted3            {{ $x.green }} {{ $x.base }}
color quoted4            {{ $x.rose }} {{ $x.base }}
color quoted5            {{ $x.yellow }} {{ $x.base }}
color body               {{ $x.aqua }} {{ $x.base }} "[\\-\\.+_a-zA-Z0-9]+@[\\-\\.a-zA-Z0-9]+"
color body underline     {{ $x.blue }} {{ $x.base }} "(https?|ftp)://[\\-\\.,/%~_:?&=\\#a-zA-Z0-9]+"
color body         bold  {{ $x.rose }} {{ $x.base }} "(^|[[:space:]])\\*[^[:space:]]+\\*([[:space:]]|$)"
color body               {{ $x.orchid }} {{ $x.base }} "(^|[[:space:]])_[^[:space:]]+_([[:space:]]|$)"
color body               {{ $x.orchid }} {{ $x.base }} "(^|[[:space:]])/[^[:space:]]+/([[:space:]]|$)"

color attach_headers     {{ $x.rose }} {{ $x.base }} "^\\[--"
color attach_headers     {{ $x.green }} {{ $x.base }} "Type: [A-Za-z0-9.+-]+/[A-Za-z0-9.+-]+"
color attach_headers     {{ $x.rose }} {{ $x.base }} "Size: [0-9.]+[KMGT]?"
color status       bold  {{ $x.blue }} {{ $x.overlay }} "NeoMutt: ([^ ]+)" 1
color status             {{ $x.green }} {{ $x.overlay }} "Msgs:[0-9/]+"
color status             {{ $x.yellow }} {{ $x.overlay }} "Flag:[0-9]+"
