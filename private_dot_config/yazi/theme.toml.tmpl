{{- $theme := index .theme.catalog .theme.active -}}
{{- $p := $theme.palette -}}
# Nocturne Rose Yazi theme, generated from theme.active ({{ .theme.active }}).
#:schema https://yazi-rs.github.io/schemas/theme.json

[app]
overall = { bg = {{ $p.base | quote }} }

[mgr]
cwd = { fg = {{ $p.rose | quote }}, bold = true }
find_keyword = { fg = {{ $p.rose | quote }}, bold = true, italic = true }
find_position = { fg = {{ $p.orchid | quote }}, bg = "reset", italic = true }
symlink_target = { fg = {{ $p.subtext | quote }}, italic = true }
marker_copied = { fg = {{ $p.green | quote }}, bg = {{ $p.green | quote }} }
marker_cut = { fg = {{ $p.red | quote }}, bg = {{ $p.red | quote }} }
marker_marked = { fg = {{ $p.orchid | quote }}, bg = {{ $p.orchid | quote }} }
marker_selected = { fg = {{ $p.rose | quote }}, bg = {{ $p.rose | quote }} }
marker_symbol = "│"
count_copied = { fg = {{ $p.black | quote }}, bg = {{ $p.green | quote }}, bold = true }
count_cut = { fg = {{ $p.black | quote }}, bg = {{ $p.red | quote }}, bold = true }
count_selected = { fg = {{ $p.black | quote }}, bg = {{ $p.rose | quote }}, bold = true }
border_symbol = "│"
border_style = { fg = {{ $p.overlay_high | quote }} }
syntect_theme = "~/.config/bat/themes/Nocturne Rose.tmTheme"

[tabs]
active = { fg = {{ $p.black | quote }}, bg = {{ $p.rose | quote }}, bold = true }
inactive = { fg = {{ $p.subtext | quote }}, bg = {{ $p.surface | quote }} }
sep_inner = { open = "", close = "" }
sep_outer = { open = "", close = "" }

[mode]
normal_main = { fg = {{ $p.black | quote }}, bg = {{ $p.rose | quote }}, bold = true }
normal_alt = { fg = {{ $p.rose | quote }}, bg = {{ $p.surface | quote }} }
select_main = { fg = {{ $p.black | quote }}, bg = {{ $p.orchid | quote }}, bold = true }
select_alt = { fg = {{ $p.orchid | quote }}, bg = {{ $p.surface | quote }} }
unset_main = { fg = {{ $p.black | quote }}, bg = {{ $p.subtext | quote }}, bold = true }
unset_alt = { fg = {{ $p.subtext | quote }}, bg = {{ $p.surface | quote }} }

[indicator]
parent = { fg = {{ $p.muted | quote }}, bg = {{ $p.mantle | quote }} }
current = { fg = {{ $p.black | quote }}, bg = {{ $p.rose | quote }}, bold = true }
preview = { fg = {{ $p.orchid | quote }}, bg = {{ $p.mantle | quote }}, underline = true }
padding = { open = "", close = "" }

[status]
overall = { fg = {{ $p.subtext | quote }}, bg = {{ $p.mantle | quote }} }
sep_left = { open = "", close = "" }
sep_right = { open = "", close = "" }
perm_type = { fg = {{ $p.blue | quote }} }
perm_read = { fg = {{ $p.yellow | quote }} }
perm_write = { fg = {{ $p.red | quote }} }
perm_exec = { fg = {{ $p.green | quote }} }
perm_sep = { fg = {{ $p.muted | quote }} }
progress_label = { fg = {{ $p.text | quote }}, bold = true }
progress_normal = { fg = {{ $p.rose | quote }}, bg = {{ $p.overlay | quote }} }
progress_error = { fg = {{ $p.black | quote }}, bg = {{ $p.red | quote }}, bold = true }

[input]
border = { fg = {{ $p.rose | quote }} }
title = { fg = {{ $p.rose | quote }}, bold = true }
value = { fg = {{ $p.text | quote }} }
selected = { fg = {{ $p.text | quote }}, bg = {{ $p.overlay_high | quote }} }

[pick]
border = { fg = {{ $p.rose | quote }} }
active = { fg = {{ $p.rose | quote }}, bold = true }
inactive = { fg = {{ $p.subtext | quote }} }

[confirm]
border = { fg = {{ $p.rose | quote }} }
title = { fg = {{ $p.rose | quote }}, bold = true }
body = { fg = {{ $p.text | quote }} }
list = { fg = {{ $p.subtext | quote }} }
btn_yes = { fg = {{ $p.black | quote }}, bg = {{ $p.rose | quote }}, bold = true }
btn_no = { fg = {{ $p.subtext | quote }}, bg = {{ $p.surface | quote }} }

[cmp]
border = { fg = {{ $p.rose | quote }} }
active = { fg = {{ $p.black | quote }}, bg = {{ $p.rose | quote }}, bold = true }
inactive = { fg = {{ $p.subtext | quote }} }

[tasks]
border = { fg = {{ $p.rose | quote }} }
title = { fg = {{ $p.rose | quote }}, bold = true }
hovered = { fg = {{ $p.rose | quote }}, bg = {{ $p.surface | quote }}, bold = true }

[which]
border = { fg = {{ $p.rose | quote }} }
cols = 3
mask = { bg = {{ $p.mantle | quote }} }
cand = { fg = {{ $p.rose | quote }}, bold = true }
rest = { fg = {{ $p.muted | quote }} }
desc = { fg = {{ $p.orchid | quote }} }
separator = "  "
separator_style = { fg = {{ $p.overlay_high | quote }} }

[help]
border = { fg = {{ $p.rose | quote }} }
chord = { fg = {{ $p.rose | quote }}, bold = true }
action = { fg = {{ $p.subtext | quote }} }
hovered = { fg = {{ $p.text | quote }}, bg = {{ $p.overlay_high | quote }}, bold = true }

[notify]
title_info = { fg = {{ $p.aqua | quote }} }
title_warn = { fg = {{ $p.yellow | quote }} }
title_error = { fg = {{ $p.red | quote }} }

[filetype]
rules = [
  # Semantic content categories
  { mime = "image/*", fg = {{ $p.aqua | quote }} },
  { mime = "{audio,video}/*", fg = {{ $p.orchid | quote }} },
  { mime = "application/*zip", fg = {{ $p.yellow | quote }} },
  { mime = "application/x-{tar,bzip*,7z-compressed,xz,rar}", fg = {{ $p.yellow | quote }} },
  { mime = "application/{pdf,doc,rtf}", fg = {{ $p.blue | quote }} },
  { mime = "vfs/{absent,stale}", fg = {{ $p.disabled | quote }} },
  { url = "*", is = "orphan", fg = {{ $p.red | quote }} },
  { url = "*", is = "exec", fg = {{ $p.green | quote }} },
  { url = "*", is = "dummy", fg = {{ $p.red | quote }} },
  { url = "*/", is = "dummy", fg = {{ $p.red | quote }} },
  { url = "*/", fg = {{ $p.orchid | quote }} },
]

[spot]
border = { fg = {{ $p.rose | quote }} }
title = { fg = {{ $p.rose | quote }}, bold = true }
tbl_col = { fg = {{ $p.orchid | quote }}, bold = true }
tbl_cell = { fg = {{ $p.black | quote }}, bg = {{ $p.rose | quote }}, bold = true }


