{{- $theme := index .theme.catalog .theme.active -}}
notARepository: skip
git:
  log:
    showGraph: always
  diffRenderers:
    - colorArg: always
      command: delta --dark --paging=never
gui:
  showBottomLine: false
  showIcons: true
  showFileIcons: true
  nerdFontsVersion: "3"
  theme:
    activeBorderColor:
      - {{ $theme.palette.rose | quote }}
      - bold
    inactiveBorderColor:
      - {{ $theme.palette.subtext | quote }}
    optionsTextColor:
      - {{ $theme.palette.orchid | quote }}
    selectedLineBgColor:
      - {{ $theme.palette.overlay | quote }}
    cherryPickedCommitBgColor:
      - {{ $theme.palette.overlay_high | quote }}
    cherryPickedCommitFgColor:
      - {{ $theme.palette.rose | quote }}
    unstagedChangesColor:
      - {{ $theme.palette.red | quote }}
    defaultFgColor:
      - {{ $theme.palette.text | quote }}
    searchingActiveBorderColor:
      - {{ $theme.palette.yellow | quote }}
  authorColors:
    "*": {{ $theme.palette.orchid | quote }}
  showCommandLog: false
