#!/usr/bin/env zsh
# exports.zsh - Environment variables and rendered secrets for interactive use
# (PATH, EDITOR, XDG, etc. are in ~/.zshenv for all shell types)

{{- if eq .chezmoi.os "darwin" }}
# API keys from Bitwarden Secrets Manager
export OPENROUTER_API_KEY='{{ (bitwardenSecrets "3b14fed8-dfa9-4617-92b9-b49e00a25e2b").value | trim }}'
export OPENCODE_API_KEY='{{ (bitwardenSecrets "9ec9dc0f-7f8e-4e81-afed-b49e00a25e97").value | trim }}'

# Supabase
export SUPABASE_URL='{{ (bitwardenSecrets "e9542789-a030-4599-9a75-b49e00a25f3d").value | trim }}'
export SUPABASE_SERVICE_KEY='{{ (bitwardenSecrets "0c3c1659-6b45-4d6a-b850-b49e00a25faf").value | trim }}'

# WCS and self-hosted LLMs
export WCS_API_KEY='{{ (bitwardenSecrets "cb9fc79d-aee2-47ec-bd20-b49e00a2601e").value | trim }}'
export WCS_DEV_API_KEY='{{ (bitwardenSecrets "98de7dd1-bca8-4672-b9dd-b4a40097b2d7").value | trim }}'
export SELFHOSTED_LLM_API_KEY='local-wireguard-only'

{{- if or (eq .profile "dt-work") (eq .profile "work") }}
# DT work-specific PATH additions and secrets
export PATH="/Users/mbastakis/dev/work/scripts/:$PATH"
export OPENAI_API_KEY='{{ (bitwardenSecrets "e884a9c6-2ee8-4c1b-a281-b49e00a264c8").value | trim }}'
export GITHUB_TOKEN='{{ (bitwardenSecrets "0eba061f-6de8-4715-b064-b49e00a26548").value | trim }}'
export GITLAB_TOKEN='{{ (bitwardenSecrets "1d6d9f0f-ac45-405a-a3b4-b49e00a265bb").value | trim }}'
export GITLAB_ACCESS_TOKEN='{{ (bitwardenSecrets "1d6d9f0f-ac45-405a-a3b4-b49e00a265bb").value | trim }}'
export GITLAB_USERNAME="michail.bastakis"
export GITLAB_HOST="gitlab.devops.telekom.de"
{{- end }}

{{- end }}

# Pager — disable rich pagers in agent/non-TTY contexts.
# OpenCode sets OPENCODE=1; its Bash tool uses piped stdout (no PTY).
if [[ -n "${OPENCODE:-}" ]] || [[ ! -t 1 ]]; then
    export PAGER="cat"
    export GIT_PAGER="cat"
    export BAT_PAGER=""
    export MANPAGER="cat"
else
    export PAGER="bat"
fi

# Less settings and colors
export LESS="-R"
export LESS_TERMCAP_mb=$'\E[1;31m'     # begin blink
export LESS_TERMCAP_md=$'\E[1;36m'     # begin bold
export LESS_TERMCAP_me=$'\E[0m'        # reset bold/blink
export LESS_TERMCAP_so=$'\E[01;44;33m' # begin reverse video
export LESS_TERMCAP_se=$'\E[0m'        # reset reverse video
export LESS_TERMCAP_us=$'\E[1;32m'     # begin underline
export LESS_TERMCAP_ue=$'\E[0m'        # reset underline

# Runtime-generated completion scripts live outside the managed config directory.
export ZSH_COMPLETION_CACHE_DIR="${ZSH_COMPLETION_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/zsh/completions}"
mkdir -p "$ZSH_COMPLETION_CACHE_DIR"

# Zoxide echo (show directory after cd)
export _ZO_ECHO=1
