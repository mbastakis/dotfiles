#compdef starship-timer

_starship-timer() {
  local context state state_descr line
  local -a commands durations timers

  commands=(
    'set:set a timer'
    'clear:clear a timer'
    'list:list active timers'
  )
  durations=(
    '30m:30 minutes'
    '1h:1 hour'
    '1h30m:1 hour 30 minutes'
    '2h:2 hours'
    '8h:8 hours'
    '12h:12 hours'
  )

  _arguments -C \
    '(-h --help)'{-h,--help}'[show help]' \
    '1:command:->command' \
    '*::argument:->arguments'

  case "$state" in
    command)
      _describe 'command' commands
      ;;
    arguments)
      case "${line[1]}" in
        set)
          (( CURRENT == 3 )) && _message 'timer name'
          (( CURRENT == 4 )) && _describe 'duration' durations
          ;;
        clear)
          timers=("$HOME/.cache/starship-timers"/*(N:t))
          (( ${#timers} )) && _describe 'timer' timers
          ;;
      esac
      ;;
  esac
}
