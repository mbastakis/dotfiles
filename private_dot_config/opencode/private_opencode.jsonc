// OpenCode v2 native configuration (migrated from v1 syntax 2026-08-20).
//
// - Written in native v2 syntax: `providers`/`permissions` array/`mcp.servers`/
//   `agents`. The v1 escape-hatch binary can NO longer read this file
//   (git history has the last v1-syntax version).
// - permissions: ordered rules, LAST matching rule wins - broad allow first,
//   destructive-operation asks after. v2 `*` crosses spaces, so single rules
//   like "kubectl* apply*" replace the v1 "kubectl apply*" + "kubectl * apply*"
//   pairs; a pattern ending in " *" also matches the bare command.
// - experimental.policies replaces v1 enabled_providers.
// - API keys stay {env:VAR} placeholders; the service resolves them from
//   `opencode2 service set env` values (chezmoi step 10).
// - Terminal client settings (theme, tabs, keybinds) live in cli.json.
{
  "$schema": "https://opencode.ai/config.json",
  "model": "wcs/gpt",
  "username": "mbastakis",
  "share": "manual",
  "autoupdate": true,
  // Server plugin: strips the parent-session ID that GPT-via-WCS fabricates
  // into the optional subagent `sessionID` argument (see file for details).
  "plugin": [
    "./server-plugins/strip-fabricated-subagent-session.js"
  ],
  "experimental": {
    "policies": [
      {
        "action": "provider.use",
        "resource": "*",
        "effect": "deny"
      },
      {
        "action": "provider.use",
        "resource": "opencode",
        "effect": "allow"
      },
      {
        "action": "provider.use",
        "resource": "selfhosted",
        "effect": "allow"
      },
      {
        "action": "provider.use",
        "resource": "openai",
        "effect": "allow"
      },
      {
        "action": "provider.use",
        "resource": "wcs",
        "effect": "allow"
      },
      {
        "action": "provider.use",
        "resource": "wcs-alt",
        "effect": "allow"
      },
      {
        "action": "provider.use",
        "resource": "wcs-dev",
        "effect": "allow"
      }
    ]
  },
  "references": {
    "dotfiles": {
      "path": "~/dev/personal/workspaces/home-workspace/dotfiles/dotfiles_main",
      "description": "Chezmoi dotfiles source: workstation config, docs, scripts. Read here for how this machine is set up; edit only via the dotfiles skill workflow."
    },
    "notes": {
      "path": "~/Documents/notes",
      "description": "Personal PARA notes vault (projects, areas, resources, archive, daily notes)."
    }
  },
  "agents": {
    "title": {
      "model": "opencode/big-pickle"
    }
  },
  "permissions": [
    {
      "action": "edit",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "rm *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "rmdir *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "chmod *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "chown *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "sudo *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "su *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git* push*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git* reset*",
      "effect": "ask"
    },
    {
