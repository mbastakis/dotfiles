{{- $theme := index .theme.catalog .theme.active -}}
{{- $palette := $theme.palette }}
"$schema" = 'https://starship.rs/config-schema.json'

palette = {{ .theme.active | replace "-" "_" | quote }}
command_timeout = 1500
add_newline = true

format = """
$username\
$hostname\
$directory\
$git_branch\
$git_state\
$git_status\
$cmd_duration\
$line_break\
$python\
$character\
"""

[os]
disabled = true
style = "bg:error fg:background"
format = "[ $symbol ]($style)"

[os.symbols]
Alpaquita = " "
Alpine = " "
AlmaLinux = " "
Amazon = " "
Android = " "
AOSC = " "
Arch = " "
Artix = " "
CachyOS = " "
