symbol = " "
style = "muted"
format = '[[ $symbol( $version) ](muted)]($style)'

[gradle]
symbol = " "

[guix_shell]
symbol = " "

[haskell]
symbol = " "
style = "muted"
format = '[[ $symbol( $version) ](muted)]($style)'

[haxe]
symbol = " "

[hg_branch]
symbol = " "

[hostname]
ssh_symbol = " "

[java]
symbol = " "
style = "muted"
format = '[[ $symbol( $version) ](muted)]($style)'

[julia]
symbol = " "

[kotlin]
symbol = " "
style = "muted"
format = '[[ $symbol( $version) ](muted)]($style)'

[lua]
symbol = " "

[memory_usage]
symbol = "󰍛 "

[meson]
symbol = "󰔷 "

[nim]
symbol = "󰆥 "

[nix_shell]
symbol = " "

[nodejs]
symbol = " "
style = "muted"
format = '[[ $symbol( $version) ](muted)]($style)'

[ocaml]
symbol = " "

[package]
symbol = "󰏗 "

[perl]
symbol = " "

[php]
symbol = " "
style = "muted"
format = '[[ $symbol( $version) ](muted)]($style)'

[pijul_channel]
symbol = " "

[pixi]
symbol = "󰏗 "

[python]
symbol = " "
format = "[$virtualenv]($style) "
style = "muted"
detect_extensions = []
detect_files = []

[rlang]
symbol = "󰟔 "

[ruby]
symbol = " "

[rust]
symbol = "󱘗 "
style = "muted"
format = '[[ $symbol( $version) ](muted)]($style)'

[scala]
symbol = " "

[status]
symbol = " "

[swift]
symbol = " "

[time]
disabled = true
time_format = "%R"
style = "bg:accent"
format = '[[  $time ](fg:background bg:accent)]($style)'

[xmake]
symbol = " "

[zig]
symbol = " "

[line_break]
disabled = false

[character]
disabled = false
success_symbol = '[❯](accent)'
error_symbol = '[❯](error)'
vimcmd_symbol = '[❮](accent_secondary)'
vimcmd_replace_one_symbol = '[❮](accent_secondary)'
vimcmd_replace_symbol = '[❮](accent_secondary)'
vimcmd_visual_symbol = '[❮](accent_secondary)'

[cmd_duration]
show_milliseconds = false
format = "[$duration]($style) "
style = "muted"
disabled = false
show_notifications = true
min_time_to_notify = 45000

[palettes.{{ .theme.active | replace "-" "_" }}]
background = {{ $palette.base | quote }}
surface = {{ $palette.surface | quote }}
overlay = {{ $palette.overlay | quote }}
text = {{ $palette.text | quote }}
subtext = {{ $palette.subtext | quote }}
muted = {{ $palette.muted | quote }}
accent = {{ $palette.rose | quote }}
accent_secondary = {{ $palette.orchid | quote }}
success = {{ $palette.green | quote }}
warning = {{ $palette.amber | quote }}
info = {{ $palette.blue | quote }}
error = {{ $palette.red | quote }}
