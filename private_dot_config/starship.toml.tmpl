[git_branch]
format = "[$branch]($style) "
style = "muted"

[git_state]
format = '\([$state( $progress_current/$progress_total)]($style)\) '
style = "muted"

[git_status]
format = "[$all_status$ahead_behind]($style) "
style = "subtext"
conflicted = ":${count} "
ahead = "⇡:${count} "
behind = "⇣:${count} "
diverged = "⇕:${ahead_count}/${behind_count} "
deleted = "✘:${count} "
modified = ":${count} "
stashed = ":${count} "
staged = ":${count} "
renamed = ":${count} "
untracked = ":${count} "

# [aws]
# symbol = " "
# style = "bg:info fg:background"
# format = '[ $symbol$profile ]($style)'

[buf]
symbol = " "

[bun]
symbol = " "

[c]
symbol = " "
style = "muted"
format = '[[ $symbol( $version) ](muted)]($style)'

[cpp]
symbol = " "

[cmake]
symbol = " "

[conda]
symbol = " "
style = "fg:background bg:info"
format = '[ $symbol$environment ]($style)'
ignore_base = false

[crystal]
symbol = " "

[dart]
symbol = " "

[deno]
symbol = " "

[docker_context]
symbol = " "

[elixir]
symbol = " "

[elm]
symbol = " "

[fennel]
symbol = " "

[fortran]
symbol = " "

[fossil_branch]
