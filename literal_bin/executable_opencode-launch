#!/bin/bash
set -euo pipefail

# opencode-launch — thin OpenCode v2 launcher.
#
# Kept as a named wrapper (instead of a bare alias) so tmux-resurrect can
# match and restore panes as `opencode-launch --continue`.
#
#   opencode-launch                 → new session in the current directory
#   opencode-launch -c|--continue   → resume the directory's last session
#   opencode-launch -s <id>         → resume a specific session
#
# Session tracking, server discovery, and reconnect are owned by the
# opencode2 background service; this wrapper adds nothing on top.

exec opencode2 "$@"
