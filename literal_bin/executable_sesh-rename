#!/usr/bin/env bash
set -euo pipefail

if ! command -v gum >/dev/null 2>&1; then
    tmux display-message "gum is not installed"
    exit 1
fi

target="${1:-session}"

case "$target" in
    session)
        current="$(tmux display-message -p '#S')"
        ;;
    window)
        current="$(tmux display-message -p '#W')"
        ;;
    *)
        tmux display-message "Unknown rename target: $target"
        exit 1
        ;;
esac

set +e
new_name="$(gum input \
    --value "$current" \
    --placeholder "New $target name" \
    --prompt 'rename> ' \
    --header "Rename $target: $current" \
    --width 40 \
    --char-limit 80)"
status=$?
set -e

if [[ $status -ne 0 || -z "$new_name" ]]; then
    exit 0
fi

if [[ "$new_name" == "$current" ]]; then
    exit 0
fi

if [[ "$target" == "session" ]]; then
    # The "=" prefix forces tmux to match the exact session name (not a prefix).
    if tmux has-session -t "=$new_name" 2>/dev/null; then
        tmux display-message "Session '$new_name' already exists"
        exit 1
    fi

    tmux rename-session "$new_name"
else
    tmux rename-window "$new_name"
fi
