sourceDir = {{ .chezmoi.sourceDir | quote }}
encryption = "age"

[age]
    identity = "~/.config/chezmoi/key.txt"
    recipient = "age1sgju3gp8hzxqprzhh4hlcq43see0yel3hus6zp8tkgqu3che2gnqkeq2jl"

[data]
    email = "mbastakis@gmail.com"
    name = "Michail Bastakis"

[diff]
    pager = "smart-diffnav"

# Normalize YAML before diffing files that CLIs re-serialize.
# textconv patterns match absolute target paths, not displayed diff paths.
[[textconv]]
    pattern = {{ printf "%s/.config/kube/config-*" .chezmoi.homeDir | quote }}
    command = "yq"
    args = ["-P", "sort_keys(..) | del(.. | select(. == null))"]

[[textconv]]
    pattern = {{ printf "%s/.config/glab-cli/config.yml" .chezmoi.homeDir | quote }}
    command = "yq"
    args = ["-P", "sort_keys(..) | del(.. | select(. == null))"]

# Colima rewrites generated blank lines with trailing spaces.
[[textconv]]
    pattern = {{ printf "%s/.local/share/colima/default/colima.yaml" .chezmoi.homeDir | quote }}
    command = "perl"
    args = ["-pe", "s/[ \\t]+$//"]

[edit]
    command = "nvim"

[merge]
    command = "nvim"
    args = ["-d"]
