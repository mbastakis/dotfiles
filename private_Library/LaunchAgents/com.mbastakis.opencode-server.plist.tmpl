<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mbastakis.opencode-server</string>

    <!-- The opencode2 background service manages its own process; this job
         only ensures it is running at login and re-checks periodically.
         `service start` is idempotent: it exits immediately when a healthy
         service already exists. -->
    <key>ProgramArguments</key>
    <array>
        <string>{{ printf "%s/.opencode/bin/opencode2" .chezmoi.homeDir }}</string>
        <string>service</string>
        <string>start</string>
    </array>

    <key>WorkingDirectory</key>
    <string>{{ .chezmoi.homeDir }}</string>

    <key>RunAtLoad</key>
    <true/>

    <key>StartInterval</key>
    <integer>300</integer>

    <key>StandardOutPath</key>
    <string>{{ printf "%s/Library/Logs/opencode-server.log" .chezmoi.homeDir }}</string>

    <key>StandardErrorPath</key>
    <string>{{ printf "%s/Library/Logs/opencode-server.error.log" .chezmoi.homeDir }}</string>

    <key>LimitLoadToSessionType</key>
    <array>
        <string>Aqua</string>
    </array>
</dict>
</plist>
