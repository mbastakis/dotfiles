<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mbastakis.opencode-service-ensure</string>

    <!-- OpenCode owns the background service process. This short-lived job
         makes the unattended remote backend available after login and repairs
         an unexpectedly stopped service. `service start` is idempotent. -->
    <key>ProgramArguments</key>
    <array>
        <string>{{ printf "%s/.opencode/bin/opencode2" .chezmoi.homeDir }}</string>
        <string>service</string>
        <string>start</string>
    </array>

    <key>WorkingDirectory</key>
    <string>{{ .chezmoi.homeDir }}</string>

    <key>RunAtLoad</key>
    <true/>

    <key>StartInterval</key>
    <integer>300</integer>

    <key>StandardOutPath</key>
    <string>{{ printf "%s/Library/Logs/opencode-service-ensure.log" .chezmoi.homeDir }}</string>

    <key>StandardErrorPath</key>
    <string>{{ printf "%s/Library/Logs/opencode-service-ensure.error.log" .chezmoi.homeDir }}</string>

    <key>LimitLoadToSessionType</key>
    <array>
        <string>Aqua</string>
    </array>
</dict>
</plist>
